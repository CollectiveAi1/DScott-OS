# Required in production. Generate each with: openssl rand -base64 32
# AUTH_SECRET signs the session cookie.
AUTH_SECRET=
# ENCRYPTION_KEY (AES-256-GCM) protects stored OAuth tokens. Must decode to exactly 32 bytes.
ENCRYPTION_KEY=
# CRON_SECRET authenticates /api/cron/tick. Vercel Cron sends it as a bearer token.
# Without it the cron route returns 503 and no job runs.
CRON_SECRET=

# Postgres. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Public URL of the app, e.g. https://os.example.com
APP_URL=http://localhost:3000

# IANA time zone used for "today", due dates and protected time.
OS_TIMEZONE=America/New_York
