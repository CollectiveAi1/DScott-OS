# Required in production. Generate each with: openssl rand -base64 32
# AUTH_SECRET signs the session cookie.
AUTH_SECRET=
# ENCRYPTION_KEY (AES-256-GCM) protects stored OAuth tokens. Must decode to exactly 32 bytes.
ENCRYPTION_KEY=
# CRON_SECRET authenticates /api/cron/tick. Vercel Cron sends it as a bearer token.
# Without it the cron route returns 503 and no job runs.
CRON_SECRET=

# Postgres. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Public URL of the app, e.g. https://os.example.com
APP_URL=http://localhost:3000

# IANA time zone used for "today", due dates and protected time.
OS_TIMEZONE=America/New_York

# Google Calendar, read-only, for the Family arena. Create an OAuth client (type: Web
# application) at console.cloud.google.com with the redirect URI ${APP_URL}/api/google/callback.
# Publish the app: a client left in Testing issues refresh tokens that expire after seven days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic, for reading a PDF, an image or free text on the schedule importer (and the
# Operator later). Without it the importer still takes CSV; the document options are disabled.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
OPERATOR_MODEL=
# Optional, for the weekly learning review. Defaults to claude-haiku-4-5-20251001.
SUMMARY_MODEL=
